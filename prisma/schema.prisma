generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  DRAFT
  QUEUED
  GENERATING
  READY
  FAILED
}

enum DocumentType {
  MODUL_AJAR
  RPP
  MODUL_PEMBELAJARAN
}

enum LedgerReason {
  PURCHASE
  DOWNLOAD
  ADMIN
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String?
  image           String?
  quotaRemaining  Int              @default(10)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  documents       Document[]
  quotaLedger     QuotaLedger[]
  transactions    Transaction[]
  accounts        Account[]
  sessions        Session[]
}

model Document {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  docType        DocumentType
  title          String
  subject        String
  grade          String
  topic          String
  contentJson    Json
  status         DocumentStatus @default(DRAFT)
  pdfStorageKey  String?
  errorMessage   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  quotaLedger    QuotaLedger[]
}

model QuotaLedger {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  delta         Int
  reason        LedgerReason
  documentId    String?
  document      Document?     @relation(fields: [documentId], references: [id])
  transactionId String?
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
  metadata      Json?
  createdAt     DateTime      @default(now())
}

model Plan {
  id        String      @id
  name      String
  downloads Int
  priceIdr  Int
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  transactions Transaction[]
}

model Transaction {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id])
  planId              String
  plan                Plan               @relation(fields: [planId], references: [id])
  amountIdr           Int
  currency            String             @default("IDR")
  status              TransactionStatus  @default(PENDING)
  provider            String             @default("MIDTRANS")
  midtransOrderId     String             @unique
  midtransTransactionId String?
  midtransRef         String?
  rawResponse         Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  quotaLedger         QuotaLedger[]
}

model PaymentEvent {
  id        String   @id @default(uuid())
  provider  String
  eventKey  String   @unique
  rawJson   Json
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
